{
  "openapi": "3.1.0",
  "info": {
    "title": "ResilAI",
    "description": "ResilAI - AI Incident Readiness Score API",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "description": "Simple health check for load balancers and orchestrators. Returns immediately with minimal processing.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Service is healthy and ready to receive traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/llm": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "LLM Status",
        "description": "Returns the current LLM configuration status. Does NOT call the LLM. Safe to expose publicly.",
        "operationId": "llm_health_health_llm_get",
        "responses": {
          "200": {
            "description": "LLM configuration status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LLMHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/cors": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "CORS Verification",
        "description": "Returns current CORS configuration for debugging. Does NOT expose secrets. Safe to call from browser console.",
        "operationId": "cors_health_health_cors_get",
        "responses": {
          "200": {
            "description": "CORS configuration status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CORSHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/system": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "System Status",
        "description": "Public system status for UI footer/build verification.",
        "operationId": "system_health_health_system_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/clinic/morning-summary": {
      "get": {
        "tags": [
          "clinic"
        ],
        "summary": "Get Morning Summary",
        "description": "Returns the Morning Safety Check for the clinic owner. DEPRECATED. Use /readiness/{org_id}.",
        "operationId": "get_morning_summary_api_clinic_morning_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MorningCheckV2"
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/api/clinic/readiness/{org_id}": {
      "get": {
        "tags": [
          "clinic"
        ],
        "summary": "Get Clinic Readiness",
        "description": "The product endpoint. Returns the immutable DailyReadinessReport.",
        "operationId": "get_clinic_readiness_api_clinic_readiness__org_id__get",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Org Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyReadinessReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/clinic/problems/{problem_id}/fix": {
      "post": {
        "tags": [
          "clinic"
        ],
        "summary": "Fix Problem",
        "description": "Triggers the autofix for a given problem.",
        "operationId": "fix_problem_api_clinic_problems__problem_id__fix_post",
        "parameters": [
          {
            "name": "problem_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Problem Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/governance/validate/{organization_id}": {
      "get": {
        "tags": [
          "internal"
        ],
        "summary": "Run IGVF validation for an organization",
        "description": "Execute the full Internal Governance Validation Framework check\nfor a single organization.\n\nReturns compliance, audit readiness, SLA gap, lifecycle risk,\nand the composite Governance Health Index (GHI).\n\nOnly available when ENV=staging.",
        "operationId": "run_igvf_validation_internal_governance_validate__organization_id__get",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Organization Id"
            }
          },
          {
            "name": "X-Admin-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Admin-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/governance/validate": {
      "get": {
        "tags": [
          "internal"
        ],
        "summary": "List all organizations with GHI scores",
        "description": "Run IGVF validation for ALL organizations and return summary.\nOnly available when ENV=staging.",
        "operationId": "run_igvf_validation_all_internal_governance_validate_get",
        "parameters": [
          {
            "name": "X-Admin-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Admin-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "description": "Root endpoint.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
